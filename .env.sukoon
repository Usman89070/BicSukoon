# Sukoon Village website (npm run dev:sukoon / build:sukoon)
VITE_SITE=sukoon
# Path this site is served under. "/bic/" + "/sukoon/" = one domain with the
# starting page at "/". Use "/" if this site gets its own domain.
VITE_BASE=/sukoon/
VITE_SITE_NAME=Sukoon Village
VITE_SITE_DESCRIPTION=Sukoon Village — Seniors Living, a Lifestyle Centre and a Childcare Centre: a village for every stage of life.
VITE_THEME_COLOR="#fbf8f3"
VITE_FAVICON=favicon-sukoon.svg
VITE_FONTS_URL=https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400;1,500&family=Nunito+Sans:opsz,wght@6..12,400;6..12,600;6..12,700&display=swap

# Public origin of the domain, e.g. https://example.org (no path). Used for
# canonical / Open Graph URLs and the sitemap. Set before deploying.
VITE_SITE_URL=
# Public URL of the Brisbane Islamic Centre website, for the "sister project" link.
# Leave empty on a single-domain deploy (defaults to its sub-path).
VITE_SISTER_URL=
# Starting page URL for the "All projects" link. Empty = "/" on a single domain.
VITE_PORTAL_URL=
