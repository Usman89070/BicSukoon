# Each website has its own committed env file: .env.bic and .env.sukoon.
# Put local or secret overrides in .env.bic.local / .env.sukoon.local (git-ignored).

# Form endpoints (optional). When empty the forms show a "not yet connected" notice
# instead of pretending to submit. Any JSON-accepting endpoint works.
VITE_CONTACT_ENDPOINT=
VITE_DONATION_ENDPOINT=
