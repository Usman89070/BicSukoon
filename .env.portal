# Starting page (npm run dev:portal / build:portal) — lets visitors choose a website.
VITE_SITE=portal
VITE_BASE=/
VITE_SITE_NAME=Brisbane Islamic Centre & Sukoon Village
VITE_SITE_DESCRIPTION=Choose a project: the Brisbane Islamic Centre — Masjid Complex and Queensland Muslim Cultural & Heritage Centre — or Sukoon Village — Seniors Living, Lifestyle Centre and Childcare Centre.
VITE_THEME_COLOR="#110e2e"
VITE_FAVICON=favicon-portal.svg
VITE_FONTS_URL=https://fonts.googleapis.com/css2?family=Montserrat:ital,wght@0,300;0,400;0,500;0,600;0,700;1,300;1,400;1,500&display=swap

# Where each box links to. Empty = /bic/ and /sukoon/ on the same domain.
VITE_BIC_URL=
VITE_SUKOON_URL=
