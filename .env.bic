# Brisbane Islamic Centre website (npm run dev:bic / build:bic)
VITE_SITE=bic
# Path this site is served under. "/bic/" + "/sukoon/" = one domain with the
# starting page at "/". Use "/" if this site gets its own domain.
VITE_BASE=/bic/
VITE_SITE_NAME=Brisbane Islamic Centre
VITE_SITE_DESCRIPTION=Brisbane Islamic Centre — a Masjid Complex and the Queensland Muslim Cultural & Heritage Centre, built on Faith, Knowledge, Community and Legacy.
VITE_THEME_COLOR="#110e2e"
VITE_FAVICON=favicon-bic.svg
VITE_FONTS_URL=https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,300;9..144,400;9..144,500&family=Manrope:wght@400;500;600;700&display=swap

# Public origin of the domain, e.g. https://example.org (no path). Used for
# canonical / Open Graph URLs and the sitemap. Set before deploying.
VITE_SITE_URL=
# Public URL of the Sukoon Village website, for the "sister project" link.
# Leave empty on a single-domain deploy (defaults to its sub-path).
VITE_SISTER_URL=
# Starting page URL for the "All projects" link. Empty = "/" on a single domain.
VITE_PORTAL_URL=
