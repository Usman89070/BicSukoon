# Clean addresses: /privacy-policy instead of /privacy-policy.html
Options -MultiViews
DirectoryIndex index.html
RewriteEngine On

# Old .html addresses redirect to the clean ones (index.html to the folder)
RewriteCond %{THE_REQUEST} \s/+((?:[^\s?]*/)?)index\.html[\s?] [NC]
RewriteRule ^ /%1 [R=301,L,NE]
RewriteCond %{THE_REQUEST} \s/+([^\s?]+)\.html[\s?] [NC]
RewriteRule ^ /%1 [R=301,L,NE]

# A clean address serves its .html file
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.+?)/?$ $1.html [L]
